# Required for live web research
TINYFISH_API_KEY=

# Optional OpenAI-compatible model for decomposition and evidence comparison
# Works with OpenAI-compatible providers such as OpenRouter when configured.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini

# App configuration
DATABASE_PATH=./data/prooftrail.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_SEARCH_RESULTS=8
MAX_FETCH_URLS=8
FETCH_TTL_SECONDS=0
