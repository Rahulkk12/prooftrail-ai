# ==============================================================================
# PROOFTRAIL AI - Backend Environment Configuration Template
# ==============================================================================

# TinyFish Credentials & Official Endpoints
# Obtain your API key from https://tinyfish.ai
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai

# Optional LLM Provider (OpenAI-compatible, e.g. OpenRouter / OpenAI)
# Used for semantic claim decomposition and deep claim verification.
# Leave blank to use the deterministic built-in rule engine.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini

# Database and Environment
DATABASE_URL=sqlite:///./data/prooftrail.db
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
MAX_SEARCH_RESULTS=8
MAX_FETCH_URLS=8
FETCH_TTL_SECONDS=0
